# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud → App settings → Secrets.
SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
# Use the service_role key (Project Settings → API). It stays server-side in Streamlit;
# never put it in client code or commit it.
SUPABASE_KEY = "YOUR-SERVICE-ROLE-KEY"
ADMIN_PASSWORD = "pick-something"

# Optional
PAYMENT_NOTE = "Venmo @your-handle or cash at the door. Suggested ~$X, but pay what you can!"
WMP_ONLY_MIN = 8      # WMP signups needed to make a night WMP-only
MIXED_MIN_EACH = 4    # min WMP and MMP for a mixed night
